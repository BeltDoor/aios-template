# Project-scoped Codex config. Committed to the repo. Loads when the project is trusted.
# TEMPLATE: the codex-ready skill fills in the user's actual local MCP servers.
#
# SECURITY: never put a secret value in this file. Forward API keys from the shell with
# `env_vars = ["KEY_NAME"]` (confirm the key is exported in the user's shell profile first).
#
# Hosted services (Gmail, Drive, Calendar, Stripe, Vercel, Supabase, Notion, etc.) connect
# through Codex's own plugins / MCP servers, not here. See references/connectors-map.md.

# --- Example: local stdio MCP server that needs a forwarded secret ---
# [mcp_servers.perplexity]
# command = "npx"
# args = ["-y", "@perplexity-ai/mcp-server"]
# env_vars = ["PERPLEXITY_API_KEY"]

# --- Example: stdio server with literal NON-secret env values ---
# [mcp_servers.example]
# command = "npx"
# args = ["-y", "some-mcp-package"]
# [mcp_servers.example.env]
# LOG_LEVEL = "error"

# --- Example: remote HTTP MCP server ---
# [mcp_servers.vercel]
# url = "https://mcp.vercel.com"
# bearer_token_env_var = "VERCEL_TOKEN"   # optional
